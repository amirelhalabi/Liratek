# Electron production TEMPLATE — placeholders only.
#
# This file previously contained a 65-byte tool-output artifact rather than
# config. The desktop app needs almost nothing here: the DB path is chosen at
# first run and stored per-install (app.getPath('userData')), and the tenant is
# fixed at boot via initFixedTenantContext(1) — there is no host, no JWT, and no
# CORS in the desktop transport.

LOG_LEVEL=info

# Optional: pins the SQLite file instead of using the first-run picker. Leave
# empty to keep the normal userData/network-share behaviour.
# DATABASE_PATH=

# Optional. Note this does NOT currently encrypt the file — stock
# better-sqlite3 has no SQLCipher codec and silently ignores `PRAGMA key`.
# See docs/DEPLOYMENT.md § At-rest data.
# DATABASE_KEY=
