{
  "name": "@liratek/electron-app",
  "version": "1.0.0",
  "description": "LiraTek Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:main && npm run build:preload && npm run setup:dist",
    "build:main": "tsc -p tsconfig.json",
    "build:preload": "tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist/preload.js','dist/preload.cjs')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "setup:dist": "node -e \"require('fs').copyFileSync('dist-package.json','dist/package.json')\"",
    "start": "electron .",
    "env:setup": "node -e \"const fs=require('fs');if(!fs.existsSync('.env'))fs.copyFileSync('.env.dev','.env')\"",
    "env:dev": "node -e \"require('fs').copyFileSync('.env.dev','.env')\"",
    "env:prod": "node -e \"require('fs').copyFileSync('.env.prod','.env')\""
  },
  "dependencies": {
    "@liratek/core": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.2",
    "electron": "^31.0.0",
    "typescript": "~5.9.3"
  }
}
