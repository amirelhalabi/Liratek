# ─────────────────────────────────────────────────────────────────────────────
# LiraTek web deployment env — copy to `.env.deploy` (gitignored) and fill in.
#
#   cp .env.deploy.example .env.deploy
#
# Consumed by docker-compose.yml (`env_file`) and validated at boot by
# packages/core/src/config/env.ts. NODE_ENV/HOST/PORT/DATABASE_PATH are set by
# compose itself — don't duplicate them here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: the app will not boot without these ────────────────────────────

# 32+ characters. Generate one, don't invent one:
#   openssl rand -base64 48
# Rotating this invalidates every issued JWT (all users must log in again).
JWT_SECRET=

# Required in production by validateProductionEnv(), but read the honest
# version first: this key currently buys you NOTHING. Stock better-sqlite3 has
# no SQLCipher codec, so `PRAGMA key` is silently ignored and the database file
# stays plaintext — verified by probe, see docs/DEPLOYMENT.md § At-rest data.
# Set it to satisfy the check; protect the data with host disk encryption and
# filesystem permissions instead.
DATABASE_KEY=

# ── Origin ───────────────────────────────────────────────────────────────────

# Must be a valid absolute URL (zod .url()). With the single-origin nginx setup
# nothing cross-origin is actually issued, but the value is still validated and
# logged, and Socket.IO uses it — so keep it truthful.
#   dev on an IP:   http://203.0.113.10
#   once you have a domain: https://liratek.example.com
CORS_ORIGIN=http://localhost

# ── First-run platform account (web/multi-tenant only) ───────────────────────
# When BOTH are set and no active super_admin exists, boot creates one with
# tenant_id NULL — the control-plane account that provisions tenants. Password
# must satisfy validatePasswordComplexity() or startup throws.
# Once the account exists you can remove these; leaving them set is a no-op.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Per-IP, per 15 minutes, in-memory. The default of 100 is sized for a single
# user, not a shop: one POS page load is many calls. Raise it before real use.
API_RATE_LIMIT_MAX=1000
# Failed login attempts per IP per 15 min. Keep this tight.
AUTH_RATE_LIMIT_MAX=10
# Failed /api/profits/unlock attempts per IP per 15 min (the Profits page password,
# LIRA-177). Successful unlocks are NOT counted, so a legitimate user re-entering the
# password on every visit to /profits never trips this.
PROFITS_UNLOCK_RATE_LIMIT_MAX=5

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Optional: voice transcription ────────────────────────────────────────────
# Leave empty to disable. Server-side only — never expose this to the browser.
# (Do NOT set VITE_HUGGINGFACE_API_KEY for a web build: anything VITE_-prefixed
# is compiled into the bundle and shipped to every visitor.)
DASHSCOPE_API_KEY=

# ── Subdomain-scoped tenancy ─────────────────────────────────────────────────
# Set this to your base domain to give each tenant its own subdomain:
#   cornertech.liratek.app -> tenant with slug 'cornertech'
#   liratek.app / admin.liratek.app -> the platform realm (super_admin only)
#
# With it set, login REFUSES credentials that do not belong to the host's
# tenant, and refuses any login to a suspended or archived tenant.
#
# Leave EMPTY until you actually have a domain. Empty means host-based
# tenancy is off and login behaves as it always has — which is what keeps a
# vercel.app or bare-IP deployment working.
APP_BASE_DOMAIN=

# Resolve the tenant from an X-Tenant-Slug header instead of the Host.
# DEVELOPMENT AND TESTS ONLY. A client can send any header it likes, so with
# this on the scoping is advisory, not enforced. NEVER set it in production.
TENANT_HOST_HEADER_OVERRIDE=
