{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "lang",
          "value": "ar"
        }
      ],
      "destination": "/ar",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://www.liratek.shop/#/login",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "https://www.liratek.shop/#/signup",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://www.liratek.shop/",
      "permanent": false
    }
  ]
}
