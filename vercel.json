{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && yarn install && yarn workspace @liratek/core build"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.ts",
      "installCommand": "cd .. && yarn install && yarn workspace @liratek/core build"
    }
  },
  "rewrites": [
    {
      "source": "/health(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
