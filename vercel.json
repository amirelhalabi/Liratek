{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && yarn install && yarn workspace @liratek/core build"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://seafood-perl-innocent-organize.trycloudflare.com/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://seafood-perl-innocent-organize.trycloudflare.com/health/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://seafood-perl-innocent-organize.trycloudflare.com/api/:path*"
    },
    {
      "source": "/socket.io/:path(.*)",
      "destination": "https://seafood-perl-innocent-organize.trycloudflare.com/socket.io/:path"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
