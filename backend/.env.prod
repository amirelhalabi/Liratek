# Backend production TEMPLATE — placeholders only, never real secrets.
#
# `yarn workspace @liratek/backend env:prod` copies this over .env (gitignored).
# Fill in the blanks locally; the copy you fill in must never be committed.
#
# NOTE: for the CONTAINER deployment you do not use this file at all — see
# .env.deploy.example at the repo root, which docker-compose.yml reads.
#
# This file previously contained a 65-byte tool-output artifact
# ("Tool call argument 'initial_content' pruned…") rather than config, so
# `env:prod` silently produced a .env that failed every production check.

NODE_ENV=production

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Origin (must be a valid absolute URL) ────────────────────────────────────
CORS_ORIGIN=https://change-me.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Absolute path. Must live on persistent storage.
DATABASE_PATH=/var/lib/liratek/liratek.db

# Required in production by validateProductionEnv(). Be aware this does NOT
# encrypt anything today: stock better-sqlite3 ships no SQLCipher codec, so
# `PRAGMA key` is silently ignored and the file stays plaintext.
# See docs/DEPLOYMENT.md § At-rest data.
DATABASE_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# 32+ chars, generated not invented:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── First-run platform account (multi-tenant web only) ───────────────────────
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=

# ── Rate limiting (per IP / 15 min) ──────────────────────────────────────────
# The 100 default is sized for one user, not a shop.
API_RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_DIR=/var/log/liratek

# ── Voice transcription (optional) ───────────────────────────────────────────
DASHSCOPE_API_KEY=
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_REGION=singapore
QWEN_ASR_LANGUAGE=en
