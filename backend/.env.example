# Backend Environment Variables
# Copy this file to .env and update with your values
# See: README.md - Environment Variables section

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development          # development | production | test

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000                     # API server port
HOST=0.0.0.0                  # Bind address (0.0.0.0 for all interfaces)

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173  # Frontend URL for CORS

# ============================================
# DATABASE
# ============================================
# Absolute path to SQLite database file
# Recommended locations:
#   macOS: ~/Documents/LiraTek/liratek.db
#   Linux: ~/Documents/LiraTek/liratek.db
#   Windows: C:/Users/<you>/Documents/LiraTek/liratek.db
DATABASE_PATH=/Users/<you>/Documents/LiraTek/liratek.db

# Optional: SQLCipher encryption key (32+ characters)
# REQUIRED in production for data encryption
# DATABASE_KEY=your-strong-32-char-encryption-key-here

# ============================================
# AUTHENTICATION
# ============================================
# JWT secret key (REQUIRED in production, 32+ characters)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d             # Token expiration (7d, 24h, etc.)

# Super admin bootstrap (multi-tenant web mode only)
# When BOTH are set and no active super_admin exists, backend startup creates
# one (role 'super_admin', tenant_id NULL — the platform control-plane realm).
# Leave unset on desktop / single-tenant installs.
# SUPER_ADMIN_USERNAME=root
# SUPER_ADMIN_PASSWORD=change-me-Strong-Password-1!

# ============================================
# LOGGING
# ============================================
# Log level: trace | debug | info | warn | error | fatal
# Auto-adjusts by environment if not set:
#   - development: debug
#   - production: info
#   - test: warn
LOG_LEVEL=info

# Optional: Directory for log files (production only)
# LOG_DIR=/var/log/liratek

# ============================================
# DOCUMENTATION
# ============================================
# See README.md - Environment Variables section for full details
# See docs/LOGGING_GUIDE.md for logging configuration

# ============================================
# VOICE TRANSCRIPTION (Qwen-ASR)
# ============================================
# Alibaba Cloud DashScope API Key
# Get from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Qwen-ASR Model Configuration
QWEN_ASR_MODEL=qwen3-asr-flash-realtime  # or qwen3-asr-pro-realtime
QWEN_ASR_REGION=singapore               # singapore | us-west-1 | eu-central-1
QWEN_ASR_LANGUAGE=en                    # en | zh | es | fr | pt | ru | ar | ja | ko

# ── Automatic tenant subdomains ────────────────────────────────────────────
#
# When a tenant is provisioned (self-service signup OR the admin panel), give
# it <slug>.<APP_BASE_DOMAIN> automatically: a CNAME at Cloudflare plus the
# hostname registered on the Vercel project. BOTH are needed -- Vercel routes
# by Host, so DNS alone is a 404 and the Vercel domain alone never resolves.
#
# The feature is OFF unless ALL FOUR below are filled in. Leaving any of them
# blank is safe: nothing is attempted, and tenants still work on the shared
# host. Provisioning also fails soft -- a bad token can never fail a signup.
#
# Where each value comes from:
#   CLOUDFLARE_API_TOKEN  Cloudflare > My Profile > API Tokens > Create Token.
#                         Use a CUSTOM token scoped to Zone > DNS > Edit on
#                         liratek.shop only -- not the Global API Key, which
#                         would give this process your whole account.
#   CLOUDFLARE_ZONE_ID    Cloudflare > liratek.shop > Overview, right column
#   VERCEL_TOKEN          vercel.com/account/tokens
#   VERCEL_PROJECT_ID     Vercel > liratek > Settings > General (prj_...)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# Only if the Vercel project belongs to a TEAM rather than your personal
# account. Without it the API reports the project as missing rather than as a
# permission problem, which is a confusing hour. Leave blank for personal.
VERCEL_TEAM_ID=

# What tenant CNAMEs point at. The default (cname.vercel-dns.com) works for
# any project; override only if Vercel shows you a per-project target.
# VERCEL_DNS_TARGET=cname.vercel-dns.com

