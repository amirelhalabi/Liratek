{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "jest", "@testing-library/jest-dom", "vite/client"],
    "noEmit": true,
    // ts-jest transpiles each file on its own, without type-checking (cold
    // run ~235s -> ~20s). Tests are type-checked by tsconfig.test.json.
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/contexts/*": ["./src/contexts/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/types/*": ["./src/types/*"],
      "@/config/*": ["./src/config/*"],
      "@shared/*": ["../packages/core/src/*"],
      "@liratek/core": ["../packages/core/src/index.ts"],
      "@liratek/ui": ["../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "src",
    "jest.setup.ts",
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx"
  ],
  "exclude": ["backend/**", "**/node_modules/**"]
}
