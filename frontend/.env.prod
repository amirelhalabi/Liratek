# Frontend production TEMPLATE — placeholders only.
#
# This file previously contained a 65-byte tool-output artifact rather than
# config, so `env:prod` produced a broken .env.
#
# READ THIS BEFORE SETTING ANYTHING: for the container deployment you should
# leave every value below empty. The nginx image serves the app and the API on
# ONE origin and injects `window.__LIRATEK_BACKEND_URL = window.location.origin`
# at runtime (see the frontend Dockerfile). That global takes precedence over
# every build-time value here, which is exactly what makes one image work on any
# hostname — IP today, your domain later, per-tenant subdomains after that —
# with no rebuild. Setting VITE_BACKEND_URL here re-bakes a hostname into the
# bundle and undoes that.

NODE_ENV=production

# Only for a NON-proxied deployment where the API lives on a different origin.
# Leave empty for the docker-compose/nginx setup.
VITE_BACKEND_URL=

# Web build, not Electron.
VITE_APP_MODE=standalone

VITE_DEBUG=false

# Do NOT set VITE_HUGGINGFACE_API_KEY in a web build. Anything VITE_-prefixed is
# compiled into the JS bundle and served to every visitor. The server-side voice
# path (DASHSCOPE_API_KEY on the backend) is the only safe option.
