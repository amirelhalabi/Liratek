{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src"],
  // Tests run (and are type-checked) under frontend's jest/tsconfig.test.
  "exclude": ["src/**/__tests__/**"]
}
